# Copy to .env.local and fill in. Never commit real values.

# Anthropic console → Settings → API keys
ANTHROPIC_API_KEY=

# Supabase dashboard → Project Settings → Data API (URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Any long random string. Must match the EMBED_FUNCTION_SECRET set on the embed edge function.
EMBED_FUNCTION_SECRET=
