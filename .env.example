# Copy to .env.local and fill in. Never commit real values.

# Anthropic console → Settings → API keys
ANTHROPIC_API_KEY=

# Supabase dashboard → Project Settings → Data API (URL) and API Keys (secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Any long random string. Must match the EMBED_FUNCTION_SECRET set on the embed edge function.
EMBED_FUNCTION_SECRET=

# Signs visitor session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional demo limits (defaults shown)
# DEMO_DAILY_BUDGET_USD=2
# DEMO_USER_CHATS_PER_MINUTE=5
# DEMO_USER_CHATS_PER_DAY=40
# DEMO_IP_CHATS_PER_DAY=100
# DEMO_IP_SESSIONS_PER_DAY=5
